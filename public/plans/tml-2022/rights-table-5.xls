d class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell">&nbsp;</td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="מבנים ומוסדות ציבור"><td  class="clsTableCell"></td><td class="clsTableCell">מבנים ומוסדות ציבור</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">407</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">65947</td><td class="clsTableCell">290166</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">6</td><td class="clsTableCell">2</td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell">&nbsp;</td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="שטח ציבורי פתוח"><td  class="clsTableCell"></td><td class="clsTableCell">שטח ציבורי פתוח</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">601</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">434</td><td class="clsTableCell"><sup>(2)</sup> 868</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">5</td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell">&nbsp;</td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="שטח ציבורי פתוח"><td  class="clsTableCell"></td><td class="clsTableCell">שטח ציבורי פתוח</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">602</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">433</td><td class="clsTableCell"><sup>(2)</sup> 866</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">5</td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell">&nbsp;</td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="שטח ציבורי פתוח"><td  class="clsTableCell"></td><td class="clsTableCell">שטח ציבורי פתוח</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">603</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">439</td><td class="clsTableCell"><sup>(2)</sup> 878</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">5</td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell"><sup>(1)</sup></td><td class="clsTableCell">&nbsp;</td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="סכום"><td  class="clsTableCell">סך הכל</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">7950</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">111067</td><td class="clsTableCell">678351</td><td class="clsTableCell">2460</td><td class="clsTableCell">1037.8</td><td class="clsTableCell">305</td><td class="clsTableCell">87</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">25920</td></tr></tbody></table><br><br><Table border=1><TR><TD><B>מספר</B></TD><TD><B>הערות לטבלת זכויות והוראות בניה - מצב מוצע</B></TD></TR><TR><TD>1</TD><TD> קווי הבניין יהיו בהתאם למסומן בתשריט.</TD></TR><TR><TD>2</TD><TD> השטחים התת קרקעיים הנ"ל בתאי שטח  601-603 הינם שטחים המיועדים לרישום תלת ממדי לטובת מעברים בין מרתפי חניה, והם ירשמו במסגרת מגרשים תלת מימדיים 603A-601A כמפורט בנספח קביעת מגרש תלת מימדי. תכסית המעברים בין מרתפי החניה לא תעלה על 40% משטח המגרש.</TD></TR></Table><br><br><Table border=1><TR><TD><B>הערות ברמת טבלה</B></TD></TR><TR><TD>א. לפחות 20% מיחידות הדיור בכל שטח התוכנית יהיו קטנות מאוד, ולפחות 10% מיחידות הדיור בכל שטח התוכנית יהיו קטנות.  
ב.  השטחים המצויינים בטבלה 5 הם שטחים על קרקעיים, עבור שטחים תת קרקעיים:
ב1. תתאפשר תוספת שטח בתת הקרקע, לטובת שטחי חניה (לרבות אופניים), אחסנה, חדרים טכניים וכיוב'.
ב2. ניתן יהיה להגדיל את מספר קומות החניה מתחת לכניסה הקובעת לטובת תוספת מקומות חניה הנדרשות על פי התקן התקף לעת הוצאת היתרי בניה. זכויות הבניה במקרה זה יכללו את כל הדרוש לפעולה התקינה של החניון לרבות מדרגות, מעליות וחדרים טכניים. 
ב3. בתא שטח 102 תתאפשר תוספת 150 מ"ר עבור מוסדות ומבני ציבור דוגמת מקווה בתת הקרקע.
ג. מתוך שטחי המגורים בטבלה 5 ביעוד 'מגורים מסחר ותעסוקה', במגרש 101 1,170 מ"ר, במגרש 102 3,100 מ"ר, במגרש 103 2,100 מ"ר, במגרש 104 1,500 מ"ר, במגרש 105 1,650 מ"ר, במגרש 106 2,140 מ"ר, במגרש 107 1,650 מ"ר יוקצו לשימושים משותפים למגורים ושטחים טכניים בקומת קרקע/גלריה וקומת הגג ומתוכם לפחות 150 מ"ר בכל תא שטח ישמשו למועדון דיירים, לא ניתן יהיה להצמיד שטחים אלו ליחידות דיור, מסחר או תעסוקה בעת רישום בית משותף.
ד. תותר תוספת של עד שתי קומות טכניות מעבר למספר הקומות המצוין בטבלה. 
ה.  במגרשים הכוללים חזית פעילה תותר קומת גלריה למסחר עד מחצית משטח המסחר בקומת הקרקע, וקומה חלקית לשימוש ציבורי עד לסך השטח הציבורי בקומת הקרקע.
קומת גלריה/חלקית לא תחשב במניין הקומות, השטחים יהיו מתוך סך הזכויות הבניה המותרות בתא השטח ולא ובנוסף להם.  
ו. תותר תוספת שטחים לטובת קירוי או הצללת חצרות מעונות יום וגני ילדים, בהתאמה לשטח החצר. 
ז. תותר תוספת שטחים לצורך ביצוע קולונדה או קירוי בדופן רחוב הרצל ברוחב של עד 4.5 מטר.
ח. היקף הדיוריות לא יעלה על 15% מסך יח"ד המתאימות, בכל שטח התוכנית.
ט. תותר תוספת שטחים לטובת שילוב רמפת כניסה לחניון בבינוי.
י. תותר בניית מרתפים בקו בניין 0, למעט במקרה שסומן בתשריט קו בניין תת קרקעי.
יא. תותר תוספת שטחים ביעודים 'מבנים ומוסדות ציבור' ו-'שטחים ציבוריים פתוחים' לטובת הקמת מקלטים ציבוריים.
יב. בתאי השטח הכוללים סימון חזית הפעילה, שטחי הבנייה לשימוש מסחר הינם לכל השימושים המתאפשרים כאמור בהגדרת 'חזית פעילה' בסעיף 1.9 בתכנית זו.
יג. גובה הבניה המירבי במסגרת התכנית לא יעלה על 136 מטר מעל פני הים, וגובה מירבי למתקני עזר לבניה לא יעלה על  151 מטר מעל פני הים, חריגה מכך תותר רק באישור משהב"ט.
יד. תתאפשר הבלטת מרפסות עד 2 מ' מעבר לקו בניין, אך לא מעבר לקו מגרש, לכיוון הרחובות בלבד.
טו. במבני מגורים פשוטים יתאפשר תכנון קומת הדירות העליונה כדירות דופלקס, וזאת בכפוף לעמידה בהגדרת 'מבנה פשוט' בפרק 1.9
טז. שטח מרפסת לא יפחת מ-6 מ"ר, ניתן להוסיף שטחים למרפסות בתאי השטח הכוללים מגורים ובתנאי ששטחים אלו לא יעלו על 14 מ"ר בממוצע למרפסת.</TD></TR></Table><br><br>